#!/bin/bash
set -xeuo pipefail

fc-cache --force --really-force --system-only --verbose

glib-compile-schemas /usr/share/glib-2.0/schemas/

mkdir -p /var/usrlocal
ln -s /var/usrlocal /usr/local
cp -a /usr/local/. /var/usrlocal/
rm -rf /usr/local
ln -s /var/usrlocal /usr/local

# Keep a backup of the package database so it can be restored at runtime if needed
mkdir -p /usr/share/factory/dpkg/
tar -czf /usr/share/factory/dpkg/dpkg.tar.gz /var/lib/dpkg
