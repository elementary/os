[Transfer]
ProtectVersion=%A
Features=driver-broadcom
Verify=yes

[Source]
Type=url-file
Path=https://%W.updates.elementaryos.org/%a/ext
MatchPattern=driver-broadcom-modules-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/EFI/Linux/elementary_@v_%a.efi.extra.d/
PathRelativeTo=boot
MatchPattern=driver-broadcom-modules-%a_@v.raw
Mode=0444
InstancesMax=2
