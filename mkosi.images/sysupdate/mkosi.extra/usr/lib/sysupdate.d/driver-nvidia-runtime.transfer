[Transfer]
ProtectVersion=%A
Features=driver-nvidia
Verify=yes

[Source]
Type=url-file
Path=https://%W.updates.elementaryos.org/%a/@v/ext
MatchPattern=driver-nvidia-runtime-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/extensions/
MatchPattern=driver-nvidia-runtime-@a_@v.raw
InstancesMax=2
