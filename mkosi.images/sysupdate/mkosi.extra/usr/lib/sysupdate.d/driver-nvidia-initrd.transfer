[Transfer]
ProtectVersion=%A
Features=driver-nvidia
Verify=yes

[Source]
Type=url-file
Path=https://%W.updates.elementaryos.org/%a/ext
MatchPattern=driver-nvidia-modules-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=elementary_@v_%a.efi.extra.d/driver-nvidia-modules-%a_@v.raw
Mode=0444
InstancesMax=2
