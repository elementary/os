[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://daily.updates.elementaryos.org/$ARCHITECTURE
MatchPattern=elementary_@v.usr-%a-verity-sig.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=elementary_@v_verity_sig
MatchPartitionType=usr-verity-sig
PartitionFlags=0
ReadOnly=1
