#!/usr/bin/env bash
set -euo pipefail

# These REALLY want to start
# By default "mask", symlinks to /etc, so manually null them
ln -sf /dev/null /usr/lib/systemd/system/systemd-firstboot.service
ln -sf /dev/null /usr/lib/systemd/system/systemd-networkd-wait-online.service


# Change dbus-daemon-launch-helper group to something normal (In the non-existant render group by default)
systemd-sysusers
chown root:987 /usr/lib/dbus-1.0/dbus-daemon-launch-helper
chmod 4754 /usr/lib/dbus-1.0/dbus-daemon-launch-helper

systemctl enable preset-global.service
