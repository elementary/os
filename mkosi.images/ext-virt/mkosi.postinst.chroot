#!/usr/bin/env bash
set -euo pipefail

# virt-manager aborts at launch unless its GSettings schema is compiled. mkosi drops the
# regenerated /usr/share/glib-2.0/schemas/gschemas.compiled since the base image already
# has one, so compile the schema into our own directory and point virt-manager at it.
# virt-manager overwrites GSETTINGS_SCHEMA_DIR, so add it through XDG_DATA_DIRS instead.
datadir=/usr/share/ext-virt
schemas=$datadir/glib-2.0/schemas
mkdir -p "$schemas" /usr/libexec/ext-virt
mv /usr/share/glib-2.0/schemas/*virt-manager* "$schemas/"
glib-compile-schemas --strict "$schemas"

mv /usr/bin/virt-manager /usr/libexec/ext-virt/virt-manager
cat > /usr/bin/virt-manager <<EOF
#!/bin/sh
export XDG_DATA_DIRS=\${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$datadir
exec /usr/libexec/ext-virt/virt-manager "\$@"
EOF
chmod 755 /usr/bin/virt-manager
