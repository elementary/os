#!/bin/bash
set -euo pipefail

if [[ "${1:-}" != "final" ]]; then
    exit 0
fi

CACHE_DIR="${SRCDIR}/flatpak-cache"
FLATPAK_DIR="/var/lib/flatpak"

if [[ -d "${CACHE_DIR}/repo" ]]; then
    echo "Restoring flatpak cache..."
    rsync -aH "${CACHE_DIR}/" "${FLATPAK_DIR}/"
fi

flatpak preinstall -y --noninteractive --system

echo "Preserving flatpak cache..."
rsync -aH --delete "${FLATPAK_DIR}/" "${CACHE_DIR}/"
