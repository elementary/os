#!/bin/bash
set -euo pipefail

if [[ "${1:-}" != "final" ]]; then
    exit 0
fi

CACHED_REPO_DIR="${SRCDIR}/flatpak/repo"
FLATPAK_REPO_DIR="/var/lib/flatpak/repo"

if [[ ! -f "${SRCDIR}/flatpak/.ci" && -d "${CACHED_REPO_DIR}" ]]; then
    echo "Load flatpak repo from local cache"
    rsync -aH "${CACHED_REPO_DIR}/" "${FLATPAK_REPO_DIR}"
fi

flatpak preinstall -y --noninteractive --system

if [[ -f "${SRCDIR}/flatpak/.ci" ]]; then
    exit 0
fi

echo "Save flatpak repo to local cache"
rsync -aH --delete "${FLATPAK_REPO_DIR}/" "${CACHED_REPO_DIR}"
